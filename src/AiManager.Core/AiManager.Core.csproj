<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web UI ships inside the assembly so the program is a single EXE. -->
    <EmbeddedResource Include="wwwroot\*" />
    <InternalsVisibleTo Include="AiManager.Tests" />
  </ItemGroup>

</Project>
